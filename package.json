{
  "name": "strangler-agent",
  "version": "0.1.0",
  "description": "Strangler Fig refactoring engine — agentic monolith-to-microservice extraction with AST gates, validation loops, rollback, PR on green",
  "type": "module",
  "bin": {
    "strangler-agent": "./bin/strangler-agent.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "ci:validate": "node scripts/ci-validate-pr.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "@cursor/sdk": "*"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
